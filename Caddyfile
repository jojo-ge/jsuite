# jSuite edge — Host-header router for the local dev apps.
# Caddy runs inside Docker on OrbStack; the apps stay NATIVE on the host,
# reached via host.docker.internal. OrbStack owns TLS: the container's
# `dev.orbstack.domains` label (docker-compose.yml) claims the .local names,
# OrbStack resolves them, terminates HTTPS with its auto-trusted local CA, and
# forwards plain HTTP to this Caddy on :80. No certs, no /etc/hosts, no sudo.

{
	# OrbStack is the TLS terminator — Caddy must stay plain HTTP.
	auto_https off
	admin off
}

# reverse_proxy to a host port. The original Host (e.g. jticket.local) is
# passed through unchanged so Vite's dev-server host check accepts it — each
# app allowlists its .local name in nuxt.config. Streaming (jDiff SSE) and
# websockets (Nuxt HMR) pass through.
(app) {
	reverse_proxy {args[0]}
}

# The upstream ports must match the APPS table in ./jsuite, and every name
# here must appear in the dev.orbstack.domains label in docker-compose.yml.

# Static index — just links to the apps. No process behind it.
http://jsuite.local:80 {
	root * /srv/www
	file_server
}

http://jticket.local:80 {
	import app host.docker.internal:43000
}

http://jdiff.local:80 {
	import app host.docker.internal:43002
}

http://jchart.local:80 {
	import app host.docker.internal:43003
}

http://jexplain.local:80 {
	import app host.docker.internal:43004
}

http://jgrilling.local:80 {
	import app host.docker.internal:43005
}

http://jrig.local:80 {
	import app host.docker.internal:43006
}

http://jagent.local:80 {
	import app host.docker.internal:43007
}
