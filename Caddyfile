# jSuite edge — Host-header router for the local dev apps.
# Caddy runs inside Docker on OrbStack; the apps stay NATIVE on the host,
# reached via host.docker.internal. OrbStack owns TLS: the container's
# `dev.orbstack.domains` label (docker-compose.yml) claims the .local names,
# OrbStack resolves them, terminates HTTPS with its auto-trusted local CA, and
# forwards plain HTTP to this Caddy on :80. No certs, no /etc/hosts, no sudo.

{
	# OrbStack is the TLS terminator — Caddy must stay plain HTTP.
	auto_https off
	admin off
}

# reverse_proxy to a host port. The original Host (jticket.local) is passed
# through unchanged so Vite's dev-server host check accepts it — jTicket
# allowlists its .local name in nuxt.config. Streaming (SSE) and websockets
# (Nuxt HMR) pass through.
(app) {
	reverse_proxy {args[0]}
}

# The upstream port must match the APPS table in ./jsuite, and every name here
# must appear in the dev.orbstack.domains label in docker-compose.yml (and in
# DOMAINS in ./jsuite).

# Static index — just links to the apps. No process behind it.
http://jsuite.local:80 {
	root * /srv/www
	file_server
}

http://jticket.local:80 {
	import app host.docker.internal:43000
}

# Redirect-only hosts. jExplain, jReview and jChart are jTicket features now,
# but stored tickets, docs and review reports still link to their old names.
# Each maps its old page path onto jTicket's (the query string is kept), and
# anything else lands on that feature's index. No process behind them.

# jExplain: /e/<key> is the same path in jTicket; the library is /e.
http://jexplain.local:80 {
	redir /e/* https://jticket.local{uri}
	redir https://jticket.local/e
}

# jReview: the room /r/<key> is /reviews/<key>.
http://jreview.local:80 {
	handle_path /r/* {
		redir https://jticket.local/reviews{uri}
	}
	handle {
		redir https://jticket.local/reviews
	}
}

# jChart: the editor /c/<key> is /charts/<key>.
http://jchart.local:80 {
	handle_path /c/* {
		redir https://jticket.local/charts{uri}
	}
	handle {
		redir https://jticket.local/charts
	}
}
