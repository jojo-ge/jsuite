#!/usr/bin/env bash
# jsuite — one command for the whole local dev suite.
#
#   ./jsuite start | stop | restart | status | logs [app] | open [app] | setup
#   ./jsuite sandbox [--port N] [--fresh] [--repos A:B] [--engines]
#
# The Nuxt apps run natively on fixed ports (they need host git/gh/claude and
# the macOS GUI, so they are deliberately NOT containerised). A single Caddy
# container fronts them all, routing by Host header; OrbStack resolves the
# .local names and terminates HTTPS with its auto-trusted local CA — no certs,
# no /etc/hosts, and no clash with anything on the host's :443 (the names
# resolve to the container's own IP).
#
#   https://jsuite.local     index
#   https://jticket.local    jTicket
#   https://jdiff.local      jDiff
#   https://jchart.local     jChart
#   https://jexplain.local   jExplain
#   https://jgrilling.local  jGrilling
#   https://jcode.local      jCode
#   https://jreview.local    jReview
set -euo pipefail

# Resolve through symlinks so a shim on PATH (e.g. ~/.local/bin/jsuite) still
# finds the repo dir this script lives in.
_src="${BASH_SOURCE[0]}"
while [[ -L "$_src" ]]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  [[ "$_src" == /* ]] || _src="$_dir/$_src"
done
HERE="$(cd -P "$(dirname "$_src")" && pwd)"
ROOT="$HERE/apps"
LOGS="$HERE/logs"
RUN="$HERE/run"

# Every app keeps its state in .data/<app>/ via @jsuite/data, which finds this
# directory on its own. Exporting it anyway pins the location regardless of the
# cwd an app is launched from, and lets a one-off run redirect somewhere else.
export JSUITE_DATA_DIR="${JSUITE_DATA_DIR:-$HERE/.data}"

# id | directory (under ./apps) | port | dev command
# Ports are fixed on purpose — tooling hardcodes them (the to-jticket skill
# posts to :43000) and the Caddyfile maps the .local names onto them. Keep this
# table and the Caddyfile in sync; nothing else needs to change to add an app.
# All apps are pnpm workspace members — deps install once via `pnpm install`
# at the repo root.
APPS=(
  "jticket|jticket|43000|pnpm dev --port 43000"
  "jdiff|jdiff|43002|pnpm dev --port 43002"
  "jchart|jchart|43003|pnpm dev --port 43003"
  "jexplain|jexplain|43004|pnpm dev --port 43004"
  "jgrilling|jgrilling|43005|pnpm dev --port 43005"
  "jcode|jcode|43006|pnpm dev --port 43006"
  "jreview|jreview|43008|pnpm dev --port 43008"
)

DOMAINS=(jsuite.local jticket.local jdiff.local jchart.local jexplain.local jgrilling.local jcode.local jreview.local)

# app dir (relative to this repo) | space-separated skills it owns
# "." is the repo root — suite-level skills live in ./.claude/skills. Everything
# else under an app's .claude/skills comes from mattpocock/skills and is
# installed by the `skills` CLI instead. Keep apps/jticket/j-setup's JSKILLS
# list in sync with its row here.
SKILLS_MANIFEST=(
  ".|jsuite"
  "apps/jticket|jimplement jorchestrate jwayfinder to-jticket to-jspec to-jdoc jarchitect-scan jarchitect-grill jreproduce jslice-report jrunplan"
  "apps/jdiff|jdiff-review jdiff-ask jdiff-tour jdiff-chains"
  "apps/jchart|j-chart"
  "apps/jexplain|j-explain"
  "apps/jgrilling|j-grilling"
  "apps/jcode|jcode jcode-mark"
  "apps/jreview|jreview-report jreview-triage jreview-consensus jarch-review make-jreview-project jreview-assess jpr-check"
)
POCOCK_SOURCE="mattpocock/skills"

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
dim() { printf '\033[2m%s\033[0m\n' "$*"; }
ok() { printf '  \033[32m●\033[0m %s\n' "$*"; }
bad() { printf '  \033[31m●\033[0m %s\n' "$*"; }
warn() { printf '  \033[33m●\033[0m %s\n' "$*"; }
die() { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }

field() { cut -d'|' -f"$1" <<<"$2"; }
app_row() { # app_row <id> -> the matching APPS entry
  local a
  for a in "${APPS[@]}"; do [[ "$(field 1 "$a")" == "$1" ]] && { echo "$a"; return 0; }; done
  return 1
}
port_listening() { lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1; }
pid_of() { # pid_of <id> -> live pid from the pidfile, or nothing
  local f="$RUN/$1.pid" pid
  [[ -f "$f" ]] || return 1
  pid="$(<"$f")"
  kill -0 "$pid" 2>/dev/null || return 1
  echo "$pid"
}

# ---------------------------------------------------------------- preflight --

check_ready() {
  [[ -d "$HERE/node_modules" ]] || die "workspace deps not installed — run: $0 setup"
  docker info >/dev/null 2>&1 || die "Docker isn't running — start OrbStack first"
  [[ "$(docker info --format '{{.OperatingSystem}}' 2>/dev/null)" == OrbStack ]] \
    || die "Docker context isn't OrbStack — the .local domains need it. Run: docker context use orbstack"
  # Stale /etc/hosts entries from the old mkcert setup would shadow OrbStack's
  # DNS and point the names at 127.0.0.1, where nothing listens on 443.
  local d stale=()
  for d in "${DOMAINS[@]}"; do
    grep -qE "^[^#]*[[:space:]]$d(\$|[[:space:]])" /etc/hosts && stale+=("$d")
  done
  ((${#stale[@]} == 0)) || die "/etc/hosts still pins ${stale[*]} (old mkcert setup) — run: $0 setup"
}

# -------------------------------------------------------------------- start --

start_app() {
  local id=$1 dir=$2 port=$3 cmd=$4 pid
  if pid="$(pid_of "$id")"; then ok "$id already running (pid $pid)"; return 0; fi
  if port_listening "$port"; then
    warn "$id — port $port is held by something we didn't start:"
    lsof -nP -iTCP:"$port" -sTCP:LISTEN | tail -n +2 | sed 's/^/      /'
    return 1
  fi
  # `set -m` puts each app in its own process group so stop can signal the whole
  # tree (pnpm/npm fork the actual nuxt process — killing just the parent orphans it).
  set -m
  ( cd "$ROOT/$dir" && exec $cmd ) >"$LOGS/$id.log" 2>&1 &
  echo $! >"$RUN/$id.pid"
  set +m
  ok "$id starting on :$port (pid $(<"$RUN/$id.pid"), log: logs/$id.log)"
}

wait_for_port() { # wait_for_port <port> <seconds>
  local i=0
  while ((i++ < $2 * 4)); do
    port_listening "$1" && return 0
    sleep 0.25
  done
  return 1
}

cmd_start() {
  check_ready
  mkdir -p "$LOGS" "$RUN"
  bold "apps"
  local a failed=0
  for a in "${APPS[@]}"; do
    start_app "$(field 1 "$a")" "$(field 2 "$a")" "$(field 3 "$a")" "$(field 4 "$a")" || failed=1
  done

  bold "edge"
  docker compose --project-directory "$HERE" up -d >/dev/null 2>&1 \
    || die "docker compose up failed — try: docker compose --project-directory $HERE up"
  ok "caddy up (OrbStack terminates HTTPS for the .local names)"

  bold "waiting for dev servers"
  for a in "${APPS[@]}"; do
    local id port
    id="$(field 1 "$a")"; port="$(field 3 "$a")"
    if wait_for_port "$port" 90; then ok "$id"; else bad "$id — not up after 90s, see logs/$id.log"; failed=1; fi
  done

  echo
  cmd_status
  ((failed == 0)) || exit 1
}

# --------------------------------------------------------------------- stop --

stop_app() {
  local id=$1 port=$2 pid
  if pid="$(pid_of "$id")"; then
    kill -TERM "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
    local i=0
    while ((i++ < 40)) && kill -0 "$pid" 2>/dev/null; do sleep 0.25; done
    kill -KILL "-$pid" 2>/dev/null || true
  fi
  rm -f "$RUN/$id.pid"
  # Belt and braces: a dev server that outlived its pidfile still owns the port,
  # and a stale listener blocks the next start.
  if port_listening "$port"; then
    local stragglers
    stragglers="$(lsof -tnP -iTCP:"$port" -sTCP:LISTEN || true)"
    [[ -z "$stragglers" ]] || kill -KILL $stragglers 2>/dev/null || true
  fi
  port_listening "$port" && bad "$id — port $port still held" || ok "$id stopped"
}

cmd_stop() {
  bold "apps"
  local a
  for a in "${APPS[@]}"; do stop_app "$(field 1 "$a")" "$(field 3 "$a")"; done
  bold "edge"
  if docker info >/dev/null 2>&1; then
    docker compose --project-directory "$HERE" down >/dev/null 2>&1 || true
    ok "caddy stopped"
  else
    warn "docker not running — nothing to stop"
  fi
}

# ------------------------------------------------------------------- status --

cmd_status() {
  local edge="down"
  [[ "$(docker inspect -f '{{.State.Running}}' jsuite-edge 2>/dev/null)" == "true" ]] && edge="up"
  bold "jsuite  (edge: $edge)"
  local a id dir port url code pid
  for a in "${APPS[@]}"; do
    id="$(field 1 "$a")"; dir="$(field 2 "$a")"; port="$(field 3 "$a")"
    url="https://$id.local"
    pid="$(pid_of "$id" || true)"
    # Generous timeout: a cold Nuxt dev server compiles on the first request.
    code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 25 "$url" 2>/dev/null || true)"
    if [[ "$code" =~ ^[23] ]]; then
      ok "$(printf '%-8s %-28s' "$dir" "$url")  :$port  pid ${pid:-?}"
    elif [[ -n "$pid" ]]; then
      warn "$(printf '%-8s %-28s' "$dir" "$url")  :$port  pid $pid  (HTTP $code)"
    else
      bad "$(printf '%-8s %-28s' "$dir" "$url")  :$port  not running"
    fi
  done
  dim "  index    https://jsuite.local"
}

# ------------------------------------------------------------- logs / open ---

cmd_logs() {
  if [[ $# -eq 0 ]]; then
    tail -n 20 -F "$LOGS"/*.log
  elif [[ "$1" == edge ]]; then
    docker compose --project-directory "$HERE" logs -f
  else
    app_row "$1" >/dev/null || die "unknown app: $1"
    tail -n 100 -F "$LOGS/$1.log"
  fi
}

cmd_open() {
  local target="${1:-jsuite}"
  [[ "$target" == jsuite ]] || app_row "$target" >/dev/null || die "unknown app: $target"
  open "https://$target.local"
}

# -------------------------------------------------------------------- setup --

# One-shot onboarding: verify OrbStack is in charge (it does DNS + HTTPS for
# the .local names via the dev.orbstack.domains label in docker-compose.yml),
# install workspace deps, install every jskill globally, migrate older .data
# shapes, and sweep up leftovers from the old mkcert/hosts-file edge.
# Re-runnable.
cmd_setup() {
  bold "orbstack"
  command -v orb >/dev/null || die "OrbStack not installed — https://orbstack.dev (brew install orbstack)"
  docker info >/dev/null 2>&1 || die "Docker isn't running — start OrbStack first"
  [[ "$(docker info --format '{{.OperatingSystem}}' 2>/dev/null)" == OrbStack ]] \
    || die "Docker context isn't OrbStack — run: docker context use orbstack"
  ok "OrbStack is the active docker context"

  bold "workspace deps"
  command -v pnpm >/dev/null || die "pnpm not installed — corepack enable (or brew install pnpm)"
  (cd "$HERE" && pnpm install) || die "pnpm install failed"
  ok "pnpm install done"

  local dest="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills"
  bold "skills -> $dest"
  mkdir -p "$dest"
  local row app skills skill src
  for row in "${SKILLS_MANIFEST[@]}"; do
    app="${row%%|*}"; skills="${row#*|}"
    for skill in $skills; do
      src="$HERE/$app/.claude/skills/$skill"
      if [[ ! -f "$src/SKILL.md" ]]; then warn "skip $skill (not found in $app)"; continue; fi
      # Link, not copy: the installed skill IS the checkout's, so a pull updates
      # it and its scripts resolve this checkout. An existing entry (an old copy,
      # or a symlink into ~/.agents/skills from the skills CLI) is replaced.
      rm -rf "${dest:?}/$skill"
      ln -s "$src" "$dest/$skill"
      ok "$skill -> $app"
    done
  done
  # Shims on PATH: `jsuite` and `jt` (bin/jt — the jTicket CLI every skill drives
  # the board through). ~/.local/bin is the conventional user bin; a shim that
  # points at an old checkout is repointed.
  bold "shims -> $HOME/.local/bin"
  mkdir -p "$HOME/.local/bin"
  ln -sfn "$HERE/jsuite" "$HOME/.local/bin/jsuite"
  ln -sfn "$HERE/bin/jt" "$HOME/.local/bin/jt"
  ok "jsuite, jt"
  case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) warn "~/.local/bin is not on PATH — add: export PATH=\"\$HOME/.local/bin:\$PATH\"" ;;
  esac

  # The mattpocock/skills CLI prompts for which skills/agents to install, so it
  # needs a real terminal; skip quietly otherwise.
  if [[ -t 0 ]]; then
    npx -y skills add "$POCOCK_SOURCE" -g || warn "$POCOCK_SOURCE install failed — rerun: npx skills add $POCOCK_SOURCE -g"
  else
    warn "no terminal — skipped the interactive $POCOCK_SOURCE installer (run: npx skills add $POCOCK_SOURCE -g)"
  fi

  # Data migrations: each rewrites an older .data shape in place and is a no-op
  # once applied, so re-running setup is always safe. Needs the deps above.
  bold "data migrations"
  (cd "$HERE/apps/jticket" && ./node_modules/.bin/tsx scripts/migrate-ticket-types.ts | sed 's/^/  /') \
    || die "jticket ticket-types migration failed"
  ok "jticket ticket types"

  bold "old mkcert edge leftovers"
  local d stale=()
  for d in "${DOMAINS[@]}"; do
    grep -qE "^[^#]*[[:space:]]$d(\$|[[:space:]])" /etc/hosts && stale+=("$d")
  done
  if ((${#stale[@]} > 0)); then
    # These would shadow OrbStack's DNS — the names must NOT resolve to 127.0.0.1.
    dim "  removing ${stale[*]} from /etc/hosts (needs sudo)"
    local pattern
    pattern="$(IFS='|'; echo "${DOMAINS[*]//./\\.}")"
    sudo sed -i '' -E "/^[^#]*[[:space:]]($pattern)([[:space:]]|\$)/d; /--- (end )?jsuite edge ---/d" /etc/hosts
    ok "/etc/hosts cleaned"
  else
    ok "/etc/hosts clean"
  fi
  if [[ -d "$HERE/certs" ]]; then
    rm -rf "$HERE/certs"
    ok "removed ./certs (OrbStack's local CA replaces mkcert)"
  else
    ok "no ./certs directory"
  fi
  echo
  dim "First HTTPS visit: OrbStack asks once to trust its local CA."
  bold "Now run: $0 start"
}

# ---------------------------------------------------------------- sandbox --
# A second jTicket that can't disturb the live suite — for building and
# testing jTicket from a worktree. It runs in the foreground from THIS
# checkout, over a copy of the live .data (taken once into .sandbox/data;
# --fresh re-takes it), on the first free port from 43100. No Caddy, no
# pidfile, no skill links: start/stop/setup are never touched.
#
# Everything that could reach live state is switched off or redirected
# (apps/jticket/server/utils/sandbox.ts):
#   JTICKET_SANDBOX=1     git/gh writes and herdr sessions only inside
#                         --repos (throwaway fixtures; none by default)
#   JTICKET_ENGINES=off   no auto loop, review runner or share sync (--engines: on)
#   JTICKET_URL           sessions it starts are pointed back at the sandbox
#   HERDR_SESSION         its panes live in herdr session `jsuite-sandbox`
#                         (start it with `herdr session attach jsuite-sandbox`;
#                         until then dispatch is simply unavailable)
#   JREVIEW/JDIFF_API_URL pointed nowhere — the live jReview and jDiff would
#                         dispatch into the live herdr and post to :43000
cmd_sandbox() {
  local port="" fresh=0 repos="" engines=off
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --port) port="$2"; shift 2 ;;
      --fresh) fresh=1; shift ;;
      --repos) repos="$2"; shift 2 ;;
      --engines) engines=on; shift ;;
      *) die "usage: $0 sandbox [--port N] [--fresh] [--repos /abs/repo:/abs/other] [--engines]" ;;
    esac
  done
  [[ -d "$HERE/node_modules" ]] || die "deps not installed in this checkout — run: pnpm install"
  if [[ -z "$port" ]]; then
    for port in $(seq 43100 43199); do port_listening "$port" || break; done
  fi
  port_listening "$port" && die "port $port is in use"
  (( port >= 43000 && port <= 43099 )) && die "ports 43000–43099 belong to the live suite"

  # The live data lives in the MAIN checkout (the one whose .git this shares).
  local common main src sb data
  common="$(git -C "$HERE" rev-parse --path-format=absolute --git-common-dir)"
  main="$(dirname "$common")"
  src="$main/.data"
  sb="$HERE/.sandbox"
  data="$sb/data"
  if [[ $fresh == 1 || ! -d "$data" ]]; then
    bold "copying $src -> $data"
    rm -rf "$data"; mkdir -p "$data"
    # Caches are rebuilt on demand; the relay config would join live shares'
    # channels; the herdr lock belongs to the live dispatchers.
    rsync -a \
      --exclude 'jdiff/diff-cache/' --exclude 'jdiff/pr-list-cache/' \
      --exclude 'herdr/' --exclude 'jticket/sync.json' \
      --exclude 'jticket/sandbox-session-settings.json' \
      "$src/" "$data/"
  fi
  [[ "$(cd "$data" && pwd -P)" != "$(cd "$src" && pwd -P)" ]] || die "sandbox data resolves to the live .data"

  export JSUITE_DATA_DIR="$data"
  export JTICKET_SANDBOX=1
  export JTICKET_ENGINES="$engines"
  export JTICKET_URL="http://localhost:$port"
  export JTICKET_SANDBOX_REPOS="$repos"
  export HERDR_SESSION="${HERDR_SESSION:-jsuite-sandbox}"
  export JREVIEW_API_URL="http://127.0.0.1:9" JDIFF_API_URL="http://127.0.0.1:9"
  unset JTICKET_SUPABASE_URL JTICKET_SUPABASE_KEY JSUITE_HERDR_LOCK

  bold "jTicket sandbox"
  ok "http://localhost:$port  (data $data)"
  dim "engines $engines · herdr session $HERDR_SESSION · writable repos: ${repos:-none}"
  cd "$ROOT/jticket"
  exec pnpm dev --port "$port"
}

case "${1:-start}" in
  start) cmd_start ;;
  stop) cmd_stop ;;
  restart) cmd_stop; echo; cmd_start ;;
  status) cmd_status ;;
  logs) shift; cmd_logs "$@" ;;
  open) shift; cmd_open "$@" ;;
  setup) cmd_setup ;;
  sandbox) shift; cmd_sandbox "$@" ;;
  # Where this checkout lives, for skills and scripts: `$(jsuite root)/.data/jchart`.
  root) echo "$HERE" ;;
  *) die "usage: $0 {start|stop|restart|status|logs [app|edge]|open [app]|setup|sandbox|root}" ;;
esac
