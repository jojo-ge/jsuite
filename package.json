{
  "name": "jsuite",
  "private": true,
  "type": "module",
  "description": "Local dev suite — jTicket, jStory, jDiff, jChart behind one HTTPS edge. `./jsuite start` runs everything.",
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "start": "./jsuite start",
    "stop": "./jsuite stop",
    "restart": "./jsuite restart",
    "status": "./jsuite status",
    "dev:jticket": "pnpm --filter jticket dev --port 43000",
    "dev:jstory": "pnpm --filter jstory dev --port 3001",
    "dev:jdiff": "pnpm --filter jdiff dev --port 43002",
    "dev:jchart": "pnpm --filter jchart dev --port 43003",
    "dev:jexplain": "pnpm --filter jexplain dev --port 43004"
  }
}
