#!/usr/bin/env bash
#
# j-setup — install every jSuite-owned skill globally, plus Matt Pocock's skills.
#
#   ./j-setup              install everything
#   ./j-setup --skills     only copy the jskills
#   ./j-setup --pocock     only install mattpocock/skills
#   ./j-setup --dry-run    show what would happen, change nothing
#
# Each app owns its skills in <app>/.claude/skills (the jTicket pattern); this
# script is the suite-wide installer. The MANIFEST below lists, per app, which
# of those skills the repo owns — everything else under an app's .claude/skills
# comes from mattpocock/skills and is installed by the `skills` CLI instead.
# Keep apps/jticket/j-setup's JSKILLS list in sync with its row here.
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEST_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills"

# app dir (relative to this repo) | space-separated skills it owns
# "." is the repo root — suite-level skills live in ./.claude/skills.
MANIFEST=(
  ".|jsuite"
  "apps/jticket|jimplement jwayfinder to-jticket to-jspec to-jdoc"
  "apps/jchart|j-chart"
  "apps/jexplain|j-explain"
)

POCOCK_SOURCE="mattpocock/skills"

DO_SKILLS=true
DO_POCOCK=true
DRY_RUN=false

while [ $# -gt 0 ]; do
  case "$1" in
    --skills)  DO_POCOCK=false ;;
    --pocock)  DO_SKILLS=false ;;
    --dry-run) DRY_RUN=true ;;
    -h|--help) sed -n '2,9p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "j-setup: unknown option '$1' (try --help)" >&2; exit 1 ;;
  esac
  shift
done

say()  { printf '%s\n' "$*"; }
run()  { if $DRY_RUN; then say "  would: $*"; else "$@"; fi; }
fail() { printf 'j-setup: %s\n' "$*" >&2; exit 1; }

$DRY_RUN && say "(dry run — nothing will be changed)"

if $DO_SKILLS; then
  say "Installing jSuite skills into $DEST_DIR"
  $DRY_RUN || mkdir -p "$DEST_DIR"

  for row in "${MANIFEST[@]}"; do
    app="${row%%|*}"
    skills="${row#*|}"
    src_dir="$REPO_DIR/$app/.claude/skills"
    [ -d "$src_dir" ] || fail "no skills directory at $src_dir"

    for skill in $skills; do
      src="$src_dir/$skill"
      dest="$DEST_DIR/$skill"

      if [ ! -f "$src/SKILL.md" ]; then
        say "  skip $skill (not found in $src_dir)"
        continue
      fi

      # An existing entry may be a real directory or a symlink into ~/.agents/skills
      # (how the skills CLI installs). Either way, replace it outright.
      if [ -e "$dest" ] || [ -L "$dest" ]; then
        run rm -rf "$dest"
      fi

      run cp -R "$src" "$dest"
      say "  installed $skill (from $app)"
    done
  done
fi

if $DO_POCOCK; then
  say "Installing $POCOCK_SOURCE"
  command -v npx >/dev/null 2>&1 || fail "npx not found — install Node.js first"
  $DRY_RUN || [ -t 0 ] || fail "the skills installer is interactive — run j-setup from a terminal (or use --skills)"

  # No -y on `skills add`: the CLI prompts for which skills and which agents to
  # install. The -y on npx only skips the "install the skills package?" prompt.
  run npx -y skills add "$POCOCK_SOURCE" -g
fi

say "Done."
