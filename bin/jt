#!/usr/bin/env python3
"""jt — jTicket from the shell, so agents stop hand-building curl + JSON parsing.

  jt ls [field=value ...]          list tickets   (projectId= status= assignee= label= frontier=1 repo=)
  jt show KEY                      one ticket as JSON
  jt new PROJECT "title" [field=value ...]
  jt set KEY field=value ...       patch a ticket (labels=a,b  blockedBy=TICK-1,TICK-2)
  jt comment KEY "body" [author]   author defaults to $JT_AUTHOR or "claude"
  jt branch KEY [branch]           cut / adopt the ticket's work branch
  jt projects [repo=...]           list projects
  jt project KEY                   one project as JSON
  jt queue PROJECT [orchestrator=N]      auto-loop queue (N = which of several orchestrators you are)
  jt claim PROJECT KEY [orchestrator=N]  orchestrator claim (JSON; exit 75 when the budget is full)
  jt prs [field=value ...]         list local PRs (projectId= ticket= status= repo=)
  jt get|post|patch|put|delete PATH [JSON|@file.json|-]   raw call, e.g. jt get /api/docs/DOC-3
                                   body inline, from a file (@plan.json) or stdin (-)

Add --json to ls/projects/prs for raw JSON. Values starting with @ are read from a file
(description=@spec.md). Base URL: $JTICKET_URL, default http://localhost:43000.
A doc record (/api/docs/DOC-n) has no body: its content is at /api/documents/<documentKey>.
Installed on PATH as ~/.local/bin/jt by `./jsuite setup`.
"""
import json
import os
import signal
import sys
import urllib.error
import urllib.parse
import urllib.request

BASE = os.environ.get('JTICKET_URL', 'http://localhost:43000').rstrip('/')
LIST_FIELDS = {'labels', 'blockedBy', 'acceptanceCriteria'}


def call(method, path, body=None):
    data = None if body is None else json.dumps(body).encode()
    req = urllib.request.Request(BASE + path, data=data, method=method, headers={'Content-Type': 'application/json'})
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            raw = r.read()
            if not raw:
                return None
            try:
                return json.loads(raw)
            except ValueError:
                # An unknown /api path falls through to the Nuxt app and answers HTML with a 200.
                sys.exit(f'jt: {method} {path} answered non-JSON — no such API route?')
    except urllib.error.HTTPError as e:
        try:
            err = json.loads(e.read())
        except ValueError:
            err = {}
        if err.get('data', {}).get('wait'):
            print(json.dumps(err), file=sys.stderr)
            sys.exit(75)
        sys.exit(f"jt: {method} {path} -> {e.code} {err.get('statusMessage') or err.get('message') or e.reason}")
    except urllib.error.URLError as e:
        sys.exit(f'jt: jTicket unreachable at {BASE} ({e.reason}) — is jsuite running?')


def value(field, v):
    if v.startswith('@'):
        with open(v[1:]) as f:
            v = f.read()
    if field in LIST_FIELDS:
        return [s for s in (x.strip() for x in v.split('\n' if field == 'acceptanceCriteria' else ',')) if s]
    return v


def raw_body(arg):
    """The JSON body of a raw call: inline, @file, or - for stdin — big bodies (doc blocks, run plans) come from files."""
    if arg == '-':
        text = sys.stdin.read()
    elif arg.startswith('@'):
        try:
            text = open(arg[1:]).read()
        except OSError as e:
            sys.exit(f'jt: cannot read body file {arg[1:]}: {e.strerror}')
    else:
        text = arg
    try:
        return json.loads(text)
    except ValueError as e:
        sys.exit(f'jt: body is not valid JSON ({e})')


def fields(args):
    out = {}
    for a in args:
        k, sep, v = a.partition('=')
        if not sep:
            sys.exit(f'jt: expected field=value, got {a!r}')
        out[k] = value(k, v)
    return out


def query(args):
    q = urllib.parse.urlencode(fields(args))
    return f'?{q}' if q else ''


def dump(x):
    print(json.dumps(x, indent=2, ensure_ascii=False))


def table(rows, cols):
    for r in rows:
        print('\t'.join(str(r.get(c) or '') for c in cols))


def main(argv):
    as_json = '--json' in argv
    argv = [a for a in argv if a != '--json']
    if not argv or argv[0] in ('-h', '--help', 'help'):
        print(__doc__.strip())
        return
    cmd, a = argv[0], argv[1:]

    if cmd in ('get', 'post', 'patch', 'put', 'delete'):
        body = raw_body(a[1]) if len(a) > 1 else ({} if cmd != 'get' and cmd != 'delete' else None)
        res = call(cmd.upper(), a[0], body)
        if res is not None:
            dump(res)
    elif cmd == 'ls':
        rows = call('GET', '/api/tickets' + query(a))
        dump(rows) if as_json else table(rows, ['key', 'status', 'type', 'assignee', 'title'])
    elif cmd == 'show':
        dump(call('GET', f'/api/tickets/{a[0]}'))
    elif cmd == 'new':
        body = {'projectId': a[0], 'title': a[1], **fields(a[2:])}
        t = call('POST', '/api/tickets', body)
        print(t['key'])
    elif cmd == 'set':
        t = call('PATCH', f'/api/tickets/{a[0]}', fields(a[1:]))
        print(f"{t['key']}\t{t['status']}\t{t['title']}")
    elif cmd == 'comment':
        author = a[2] if len(a) > 2 else os.environ.get('JT_AUTHOR', 'claude')
        call('POST', f'/api/tickets/{a[0]}/comments', {'body': value('body', a[1]), 'author': author})
    elif cmd == 'branch':
        dump(call('POST', f'/api/tickets/{a[0]}/branch', {'branch': a[1]} if len(a) > 1 else {}))
    elif cmd == 'projects':
        rows = call('GET', '/api/projects' + query(a))
        dump(rows) if as_json else table(rows, ['key', 'id', 'mode', 'title'])
    elif cmd == 'project':
        dump(call('GET', f'/api/projects/{a[0]}'))
    elif cmd == 'queue':
        dump(call('GET', f'/api/projects/{a[0]}/auto/queue' + query(a[1:])))
    elif cmd == 'claim':
        dump(call('POST', f'/api/projects/{a[0]}/auto/claim', {'ticket': a[1], **fields(a[2:])}))
    elif cmd == 'prs':
        rows = call('GET', '/api/prs' + query(a))
        dump(rows) if as_json else table(rows, ['key', 'status', 'ticketKey', 'title'])
    else:
        sys.exit(f'jt: unknown command {cmd!r} — jt help')


if __name__ == '__main__':
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    try:
        main(sys.argv[1:])
    except IndexError:
        sys.exit('jt: missing argument — jt help')
