#!/usr/bin/env bash
#
# j-setup — install the jTicket skills globally and pull in Matt Pocock's skills.
#
#   ./j-setup              install everything
#   ./j-setup --skills     only link the jTicket skills
#   ./j-setup --pocock     only install mattpocock/skills
#   ./j-setup --dry-run    show what would happen, change nothing
#
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# The suite launcher two levels up owns the skill list (SKILLS_MANIFEST) and the
# one link/prune implementation; --skills delegates to it rather than keeping a
# second copy that could drift.
JSUITE="$REPO_DIR/../../jsuite"

POCOCK_SOURCE="mattpocock/skills"

DO_SKILLS=true
DO_POCOCK=true
DRY_RUN=false

while [ $# -gt 0 ]; do
  case "$1" in
    --skills)  DO_POCOCK=false ;;
    --pocock)  DO_SKILLS=false ;;
    --dry-run) DRY_RUN=true ;;
    -h|--help) sed -n '2,9p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "j-setup: unknown option '$1' (try --help)" >&2; exit 1 ;;
  esac
  shift
done

say()  { printf '%s\n' "$*"; }
run()  { if $DRY_RUN; then say "  would: $*"; else "$@"; fi; }
fail() { printf 'j-setup: %s\n' "$*" >&2; exit 1; }

$DRY_RUN && say "(dry run — nothing will be changed)"

if $DO_SKILLS; then
  [ -x "$JSUITE" ] || fail "no suite launcher at $JSUITE — j-setup runs from apps/jticket of a jSuite checkout"
  # The jTicket row only, as j-setup always installed; prunes dangling links too.
  skills_args=(skills --only apps/jticket)
  $DRY_RUN && skills_args+=(--dry-run)
  "$JSUITE" "${skills_args[@]}"
fi

if $DO_POCOCK; then
  say "Installing $POCOCK_SOURCE"
  command -v npx >/dev/null 2>&1 || fail "npx not found — install Node.js first"
  $DRY_RUN || [ -t 0 ] || fail "the skills installer is interactive — run j-setup from a terminal (or use --skills)"

  # No -y on `skills add`: the CLI prompts for which skills and which agents to
  # install. The -y on npx only skips the "install the skills package?" prompt.
  run npx -y skills add "$POCOCK_SOURCE" -g
fi

say "Done."
